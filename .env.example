# =====================================================================
# UI Component Generator — environment variables
# Copy this file to `.env.local` and fill in the values.
# =====================================================================

# Which AI provider to use. Options:
#   "groq"       — FREE (recommended). Llama 3.3 70B, very fast.
#   "ollama"     — FREE, 100% local. Needs Ollama running on your machine.
#   "anthropic"  — paid. Claude.
#   "openai"     — paid. GPT-4.
AI_PROVIDER=groq

# ---- Groq (default, FREE) -------------------------------------------
# Get a free API key (no credit card): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Ollama (FREE, runs locally) ------------------------------------
# Install from https://ollama.com, then:
#   ollama pull qwen2.5-coder:7b
#   ollama serve
# After that, set AI_PROVIDER=ollama and leave the rest at the defaults.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ---- Anthropic Claude (paid) ----------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- OpenAI (paid) --------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- App ------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="UI Component Generator"
